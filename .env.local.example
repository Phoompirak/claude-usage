# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่า (ไฟล์ .env.local ไม่ถูก commit)

# passphrase ที่ใช้เข้ารหัส data.enc.json — ตั้งเองตามใจ ยาว ๆ จะปลอดภัยกว่า
CU_PASSPHRASE=change-me-to-something-long

# ป้ายชื่อที่จะโชว์บน dashboard (อยู่ในไฟล์เข้ารหัส คนอื่นมองไม่เห็น)
CU_LABEL=librarymsu.service@gmail.com

# แผนที่ใช้อยู่: pro | max5 | max20  (ใช้ประมาณเพดาน 5 ชม.)
CU_PLAN=pro

# โซนเวลาสำหรับจัดกลุ่มรายวัน
CU_TZ=Asia/Bangkok
